PORT=5000

# MongoDB Atlas connection string, or a local instance.
# Local fallback used automatically if this is unset: mongodb://localhost:27017/ai-finance-tracker
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/ai-finance-tracker?retryWrites=true&w=majority

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# Optional - when present, AI insights are generated by OpenAI; otherwise heuristics are used.
# The app is fully functional without this key.
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

FRONTEND_URL=http://localhost:5173
